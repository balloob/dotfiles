# Test dockerfile to see if install.sh works.
FROM mcr.microsoft.com/devcontainers/python:1-3.12-bookworm

# The base image ships a yarn apt repo whose signing key is no longer
# available, which makes `apt-get update` fail. Nothing here needs yarn.
RUN rm -f /etc/apt/sources.list.d/yarn.list

WORKDIR /workspaces

COPY . /root/dotfiles
RUN /root/dotfiles/install.sh

CMD zsh
